# Donora+ Environment Configuration
# Copy this file and fill in real values.
# Pass these via --dart-define at build time:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://your-project.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=your-anon-key
#
# SECURITY: The Supabase SERVICE ROLE KEY must NEVER appear here
# or anywhere in the Flutter client codebase. It belongs only in
# server-side Supabase Edge Functions.
# The QWEN_API_KEY is also server-side only — stored as a Supabase
# Edge Function secret, never in the client.

SUPABASE_URL=
SUPABASE_ANON_KEY=
